#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=scripts/astra-extras-common
source "$SCRIPT_DIR/astra-extras-common"

runtime=$(astra_runtime_dir)
unit_dir=$(astra_unit_dir)
binding_file=$(astra_bindings_file)

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user disable --now quickshell-astra-holiday-annual-update.timer >/dev/null 2>&1 || true
fi
rm -f -- "$unit_dir/quickshell-astra-holiday-annual-update.service" \
  "$unit_dir/quickshell-astra-holiday-annual-update.timer"
if command -v systemctl >/dev/null 2>&1; then systemctl --user daemon-reload >/dev/null 2>&1 || true; fi

if [[ -f "$binding_file" ]]; then
  temp=$(mktemp "${TMPDIR:-/tmp}/astra-bindings.XXXXXX")
  trap 'rm -f -- "${temp:-}"' EXIT
  astra_filter_binding_blocks "$binding_file" "$temp"
  if command -v lua >/dev/null 2>&1; then lua -e "assert(loadfile('$temp'))"; fi
  install -m 600 "$temp" "$binding_file"
  rm -f -- "$temp"; trap - EXIT
fi

rm -rf -- "$runtime"
rmdir -- "$(dirname -- "$runtime")" 2>/dev/null || true

#!/usr/bin/env bash

ASTRA_PLUGIN_ID="io.github.sanjyay.quickshell-astra"
ASTRA_BLOCK_BEGIN="-- BEGIN QUICKSHELL-ASTRA MANAGED BLOCK"
ASTRA_BLOCK_END="-- END QUICKSHELL-ASTRA MANAGED BLOCK"
ASTRA_LEGACY_BLOCK_BEGIN="-- BEGIN QUICKSHELL-RISE MANAGED BLOCK"
ASTRA_LEGACY_BLOCK_END="-- END QUICKSHELL-RISE MANAGED BLOCK"

astra_data_home() { printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}"; }
astra_config_home() { printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}"; }
astra_runtime_dir() { printf '%s/quickshell-astra/runtime\n' "$(astra_data_home)"; }
astra_unit_dir() { printf '%s/systemd/user\n' "$(astra_config_home)"; }
astra_bindings_file() { printf '%s/hypr/bindings.lua\n' "$(astra_config_home)"; }

astra_filter_binding_blocks() {
  local input=$1 output=$2
  awk -v begin="$ASTRA_BLOCK_BEGIN" -v end="$ASTRA_BLOCK_END" \
      -v legacy_begin="$ASTRA_LEGACY_BLOCK_BEGIN" -v legacy_end="$ASTRA_LEGACY_BLOCK_END" '
    $0 == begin || $0 == legacy_begin { managed=1; next }
    $0 == end || $0 == legacy_end { managed=0; next }
    !managed { print }
  ' "$input" >"$output"
}

astra_append_binding_block() {
  cat >>"$1" <<'LUA'

-- BEGIN QUICKSHELL-ASTRA MANAGED BLOCK
hl.unbind("SUPER + CTRL + V")
o.bind("SUPER + CTRL + V", "Quickshell Astra clipboard history", "omarchy-shell quickshell-astra-clipboard toggle")
-- END QUICKSHELL-ASTRA MANAGED BLOCK
LUA
}
